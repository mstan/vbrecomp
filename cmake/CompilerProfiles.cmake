# Optional compiler experiment. Ordinary portable builds remain the default.
set(VBRECOMP_PGO_MODE NONE CACHE STRING "Runtime PGO: NONE, GENERATE, USE")
set_property(CACHE VBRECOMP_PGO_MODE PROPERTY STRINGS NONE GENERATE USE)
set(VBRECOMP_PGO_DATA "profile-data" CACHE STRING "GCC profile directory; relative generation paths use runtime cwd")
string(TOUPPER "${VBRECOMP_PGO_MODE}" VBRECOMP_PGO_ACTIVE)
if(NOT VBRECOMP_PGO_ACTIVE MATCHES "^(NONE|GENERATE|USE)$")
    message(FATAL_ERROR "VBRECOMP_PGO_MODE must be NONE, GENERATE or USE")
endif()
set(VBRECOMP_PGO_DIGEST "none")
set(VBRECOMP_PGO_COMPILE_OPTIONS "")
set(VBRECOMP_PGO_LINK_OPTIONS "")
file(TO_NATIVE_PATH "${CMAKE_BINARY_DIR}" _vb_pgo_prefix)
if(NOT VBRECOMP_PGO_ACTIVE STREQUAL "NONE")
    if(NOT CMAKE_C_COMPILER_ID STREQUAL "GNU" OR NOT CMAKE_CXX_COMPILER_ID STREQUAL "GNU"
       OR CMAKE_C_COMPILER_VERSION VERSION_LESS 11 OR CMAKE_CXX_COMPILER_VERSION VERSION_LESS 11)
        message(STATUS "This PGO control needs GCC11+ C/C++; using the ordinary portable build")
        set(VBRECOMP_PGO_ACTIVE NONE)
    elseif(VBRECOMP_PGO_DATA STREQUAL "")
        message(FATAL_ERROR "PGO needs an explicit data directory")
    elseif(VBRECOMP_PGO_ACTIVE STREQUAL "GENERATE")
        set(VBRECOMP_PGO_COMPILE_OPTIONS "-fprofile-generate=${VBRECOMP_PGO_DATA}" "-fprofile-prefix-path=${_vb_pgo_prefix}" -fprofile-update=atomic)
        set(VBRECOMP_PGO_LINK_OPTIONS "-fprofile-generate=${VBRECOMP_PGO_DATA}")
    else()
        get_filename_component(_vb_pgo_data "${VBRECOMP_PGO_DATA}" ABSOLUTE BASE_DIR "${CMAKE_BINARY_DIR}")
        # Require a named profile folder, never a drive root. Profiles are
        # private, bounded inputs from the matching source/compiler/build tree.
        get_filename_component(_vb_pgo_parent "${_vb_pgo_data}" DIRECTORY)
        if(_vb_pgo_parent STREQUAL _vb_pgo_data OR NOT IS_DIRECTORY "${_vb_pgo_data}")
            message(FATAL_ERROR "PGO USE needs an existing named data directory")
        endif()
        file(GLOB_RECURSE _vb_pgo_files LIST_DIRECTORIES FALSE "${_vb_pgo_data}/*.gcda")
        if(NOT _vb_pgo_files)
            message(FATAL_ERROR "PGO USE has no trained .gcda files")
        endif()
        list(SORT _vb_pgo_files)
        set(_vb_pgo_identity "")
        foreach(_vb_profile IN LISTS _vb_pgo_files)
            file(RELATIVE_PATH _vb_relative "${_vb_pgo_data}" "${_vb_profile}")
            file(SHA256 "${_vb_profile}" _vb_hash)
            string(APPEND _vb_pgo_identity "${_vb_relative}:${_vb_hash};")
            set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_vb_profile}")
        endforeach()
        string(SHA256 VBRECOMP_PGO_DIGEST "${_vb_pgo_identity}")
        set(VBRECOMP_PGO_COMPILE_OPTIONS "-fprofile-use=${_vb_pgo_data}" "-fprofile-prefix-path=${_vb_pgo_prefix}" -fprofile-partial-training -Werror=missing-profile)
    endif()
endif()
