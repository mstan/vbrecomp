diff --git a/libretro.cpp b/libretro.cpp
index bbdcb4f..e117354 100644
--- a/libretro.cpp
+++ b/libretro.cpp
@@ -99,6 +99,135 @@ static uint32 GPROM_Mask;
 
 V810 *VB_V810 = NULL;
 
+/* ===== vbrecomp: always-on per-instruction CPU-hook ring =============
+ * RB_CPUHOOK (v810_cpu.cpp, both Run_Accurate and Run_Fast) calls
+ * vb_oracle_cpuhook() once per RETIRED guest instruction, recording
+ * {pc, psw, regs-fingerprint, cumulative cycle}. This is the oracle
+ * half of the recomp-vs-oracle first-divergence + cycle-Delta harness
+ * (Axis 1/2/3/6). Observability ONLY — it does not touch emulation
+ * (no timestamp/state writes), so the oracle stays bit-identical.
+ *
+ * The V810's v810_timestamp is FRAME-RELATIVE (RebaseTS/ResetTS each
+ * frame in Emulate()), so we add g_vb_cpuhook_frame_base — the cumulative
+ * cycle total of all prior frames, advanced in Emulate() after Run() —
+ * to recover a monotonic cumulative cycle per instruction. */
+#include <stdint.h>
+typedef struct {
+   uint32_t pc;
+   uint32_t psw;     /* S_REG[PSW] (CY=0x8 OV=0x4 S=0x2 Z=0x1, + ID/EP/NP/...) */
+   uint32_t fnv;     /* FNV-1a over PR1..PR31 (PR0 is hardwired 0) */
+   uint32_t pad;
+   uint64_t cycle;   /* cumulative guest cycle at this instruction */
+} vb_cpuhook_rec;
+
+/* Continuous history with absolute sequence numbers and explicit eviction. */
+#define VB_CPUHOOK_RING (1u << 23)
+static vb_cpuhook_rec s_vb_ch_ring[VB_CPUHOOK_RING];
+static uint64_t       s_vb_ch_total;          /* retired-instr count (caps at RING) */
+uint64_t              g_vb_cpuhook_frame_base; /* cumulative cycles before current frame */
+
+extern "C" void vb_oracle_cpuhook(uint32_t pc, const uint32_t *p_reg,
+                                  uint32_t psw, uint64_t cycle_rel)
+{
+   /* Version 2 includes all writable GPRs, including LP. */
+   uint32_t h = 2166136261u;
+   for (int i = 1; i < 32; ++i) { h = (h ^ p_reg[i]) * 16777619u; }
+   vb_cpuhook_rec *e = &s_vb_ch_ring[s_vb_ch_total & (VB_CPUHOOK_RING-1)];
+   e->pc = pc; e->psw = psw; e->fnv = h; e->pad = 2;
+   e->cycle = g_vb_cpuhook_frame_base + cycle_rel;
+   s_vb_ch_total++;
+}
+
+extern "C" uint64_t vb_oracle_cpuhook_head(void) { return s_vb_ch_total; }
+
+/* Copy up to `max` records starting at absolute seq `from` into `out`
+ * (caller-provided). Clamps `from` up to the oldest still-resident seq
+ * so a lagging consumer sees a gap, never a silent skip. Returns the
+ * count copied; *out_resident_lo gets the oldest readable seq. */
+extern "C" uint32_t vb_oracle_cpuhook_query(uint64_t from, uint32_t max,
+                                            vb_cpuhook_rec *out,
+                                            uint64_t *out_resident_lo)
+{
+   const uint64_t head = s_vb_ch_total;
+   const uint64_t lo = (head > VB_CPUHOOK_RING) ? head - VB_CPUHOOK_RING : 0;
+   if (out_resident_lo) *out_resident_lo = lo;
+   uint64_t cur = from < lo ? lo : from;
+   uint32_t n = 0;
+   while (n < max && cur < head) { out[n++] = s_vb_ch_ring[cur & (VB_CPUHOOK_RING-1)]; cur++; }
+   return n;
+}
+
+/* ---- VIP draw-timing phase ring (Axis-5a phase gate) ----------------
+ * mednafen/vb/vip.c calls vb_oracle_vipphase() at each INTPND-raise
+ * (FRAME_START/GAME_START/XP_END/L|R FB_END) with DPSTTS/XPSTTS computed at
+ * that instant. First-N-from-boot so the boot window never evicts. Record
+ * layout MUST match runtime/include/vip_phase.h (16 bytes). Observability
+ * only — does not change emulation, oracle stays bit-identical. */
+typedef struct {
+   uint64_t seq;
+   uint16_t event, dpstts, xpstts, reserved;
+} vb_vipphase_rec;
+#define VB_VIPPHASE_RING (1u << 16)
+static vb_vipphase_rec s_vb_vp_ring[VB_VIPPHASE_RING];
+static uint64_t        s_vb_vp_total;
+
+/* Axis-6 whole-session fidelity: per-game-frame WRAM fingerprint, hashed at
+ * each GAME_START (1:1-aligned with the recomp via the proven GAME_START
+ * sequence). 64 per-1KiB-region FNV-1a hashes so a single volatile cell does
+ * not avalanche the whole frame. Layout matches runtime/include/wram_hash.h
+ * (264 bytes). */
+#define VB_WRAMHASH_REGIONS 64
+typedef struct { uint64_t seq; uint32_t fnv[VB_WRAMHASH_REGIONS]; } vb_wramhash_rec;
+#define VB_WRAMHASH_RING (1u << 15)
+static vb_wramhash_rec s_vb_wh_ring[VB_WRAMHASH_RING];
+static uint64_t        s_vb_wh_total;
+
+extern "C" void vb_oracle_vipphase(uint16_t event, uint16_t dpstts, uint16_t xpstts)
+{
+   /* WRAM fingerprint at the game-frame boundary (GAME_START = 0x0008). */
+   if (event == 0x0008 && WRAM && s_vb_wh_total < VB_WRAMHASH_RING) {
+      vb_wramhash_rec *w = &s_vb_wh_ring[s_vb_wh_total];
+      w->seq = s_vb_wh_total;
+      for (int r = 0; r < VB_WRAMHASH_REGIONS; ++r) {
+         const uint8_t *p = WRAM + r * 1024;
+         uint32_t h = 2166136261u;
+         for (int i = 0; i < 1024; ++i) { h ^= p[i]; h *= 16777619u; }
+         w->fnv[r] = h;
+      }
+      s_vb_wh_total++;
+   }
+
+   if (s_vb_vp_total >= VB_VIPPHASE_RING) return;   /* frozen: boot window full */
+   vb_vipphase_rec *e = &s_vb_vp_ring[s_vb_vp_total];
+   e->seq = s_vb_vp_total;
+   e->event = event; e->dpstts = dpstts; e->xpstts = xpstts; e->reserved = 0;
+   s_vb_vp_total++;
+}
+extern "C" uint64_t vb_oracle_wramhash_head(void) { return s_vb_wh_total; }
+extern "C" uint32_t vb_oracle_wramhash_query(uint64_t from, uint32_t max,
+                                             vb_wramhash_rec *out,
+                                             uint64_t *out_resident_lo)
+{
+   const uint64_t head = s_vb_wh_total;
+   if (out_resident_lo) *out_resident_lo = 0;   /* first-N never evicts */
+   uint64_t cur = from; uint32_t n = 0;
+   while (n < max && cur < head) { out[n++] = s_vb_wh_ring[cur]; cur++; }
+   return n;
+}
+extern "C" uint64_t vb_oracle_vipphase_head(void) { return s_vb_vp_total; }
+extern "C" uint32_t vb_oracle_vipphase_query(uint64_t from, uint32_t max,
+                                             vb_vipphase_rec *out,
+                                             uint64_t *out_resident_lo)
+{
+   const uint64_t head = s_vb_vp_total;
+   if (out_resident_lo) *out_resident_lo = 0;   /* first-N never evicts */
+   uint64_t cur = from;
+   uint32_t n = 0;
+   while (n < max && cur < head) { out[n++] = s_vb_vp_ring[cur]; cur++; }
+   return n;
+}
+/* ===================================================================== */
+
 static uint32 VSU_CycleFix;
 
 static uint8 WCR;
@@ -1938,6 +2067,11 @@ static void Emulate(EmulateSpecStruct *espec, int16_t *sound_buf)
 
    v810_timestamp = VB_V810->Run(EventHandler);
 
+   /* vbrecomp cpuhook: advance the cumulative cycle base by this frame's
+    * total now that Run() has retired all of this frame's instructions
+    * (their records used the pre-frame base). See vb_oracle_cpuhook. */
+   g_vb_cpuhook_frame_base += (uint64_t)(uint32_t)v810_timestamp;
+
    FixNonEvents();
    ForceEventUpdates(v810_timestamp);
 
